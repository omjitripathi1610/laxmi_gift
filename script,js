let counter = 0;
const target = 108;

// Function for 108 Radha Naam Jaap Counter
function countJaap() {
    if (counter < target) {
        counter++;
        document.getElementById("count").innerText = counter + " / " + target;
        
        // Progress Bar Update
        let percentage = (counter / target) * 100;
        document.getElementById("myBar").style.width = percentage + "%";

        // Unlock Birthday Content when counter hits 108
        if (counter === target) {
            setTimeout(() => {
                document.getElementById("lock-screen").style.display = "none";
                document.getElementById("birthday-content").style.display = "block";
            }, 300);
        }
    }
}


// Surprise Button par Click karne par Modal kholne ka function
function openSurprise() {
    document.getElementById("surpriseModal").style.display = "block";
    // Pehle Radha Rani ka Darshan wala Step dikhana
    document.getElementById("radhaStep").classList.add("active-step");
    document.getElementById("friendStep").classList.remove("active-step");
}

// "Radhe Radhe" button par click karne par Photos kholne ka function
function showFriendPhotos() {
    document.getElementById("radhaStep").classList.remove("active-step");
    document.getElementById("friendStep").classList.add("active-step");
}

// Modal ko close karne ka function
function closeSurprise() {
    document.getElementById("surpriseModal").style.display = "none";
}

// Window ke bahar click karne par modal band hona
window.onclick = function(event) {
    var modal = document.getElementById("surpriseModal");
    if (event.target == modal) {
        modal.style.display = "none";
    }
}
// Aage Badhiye Button Click Logic
const nextBtn = document.getElementById('nextSectionBtn');
const doctorSection = document.getElementById('doctorFutureSection');
const backToTopBtn = document.getElementById('backToTopBtn');

nextBtn.addEventListener('click', () => {
    // Hidden section ko show karo
    doctorSection.classList.remove('hidden');
    
    // Smooth scroll down to doctor section
    doctorSection.scrollIntoView({ behavior: 'smooth' });
});

// Wapas Main Page / Top Pe Jane Ka Logic
backToTopBtn.addEventListener('click', () => {
    window.scrollTo({
        top: 0,
        behavior: 'smooth'
    });
});
